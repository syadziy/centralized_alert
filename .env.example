# =========================
# APPLICATION
# =========================
SPRING_PROFILES_ACTIVE=local

# =========================
# DATABASE
# =========================
DB_URL=jdbc:postgresql://localhost:5432/centralized_alert
DB_USERNAME=admin
DB_PASSWORD=admin_macbook
DB_POOL_MIN_IDLE=2
DB_POOL_MAX_SIZE=10

# =========================
# SMTP EMAIL
# =========================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLED=false
MAIL_STARTTLS_REQUIRED=false
MAIL_CONNECTION_TIMEOUT=5000
MAIL_READ_TIMEOUT=10000
MAIL_WRITE_TIMEOUT=10000
MAIL_DEBUG=false

# =========================
# KAFKA
# =========================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=centralized-alert-consumer
KAFKA_CONSUMER_CONCURRENCY=3
KAFKA_TRUSTED_PACKAGES=com.mac.alert

# =========================
# SCHEDULER
# =========================
SCHEDULER_POOL_SIZE=2

# =========================
# FILE UPLOAD
# =========================
MAX_ATTACHMENT_FILE_SIZE=10MB
MAX_ATTACHMENT_REQUEST_SIZE=25MB

# =========================
# SERVER
# =========================
SERVER_PORT=9003

# =========================
# CENTRALIZED ALERT CONFIG
# =========================
ALERT_DEFAULT_MAX_RETRY=5
ALERT_DEFAULT_PRIORITY=5
ALERT_PICKUP_ENABLED=true
ALERT_PICKUP_INTERVAL=PT1M
ALERT_PICKUP_INITIAL_DELAY=PT10S
ALERT_PICKUP_BATCH_SIZE=50
ALERT_MAX_RETRY=5
ALERT_RETRY_INITIAL_DELAY=PT1M
ALERT_RETRY_MAX_DELAY=PT30M
ALERT_PROCESSING_TIMEOUT=PT10M
ALERT_MAX_RPARALLELISM=10
MAIL_DEFAULT_FROM=no-reply@example.com
MAIL_DEFAULT_FROM_NAME=Centralized Alert
MAIL_REPLY_TO=
MAIL_MAX_RECIPIENTS=100
MAIL_MAX_ATTACHMENTS=10
MAIL_MAX_TOTAL_ATTACHMENT_SIZE=25MB
ALERT_KAFKA_ENABLED=true
ALERT_KAFKA_TOPIC=centralized-alert.requested
ALERT_KAFKA_CREATE_TOPIC=centralized-alert.create
ALERT_KAFKA_DLT_TOPIC=centralized-alert.requested.dlt
ALERT_KAFKA_RETRY_INTERVAL_MS=1000
ALERT_KAFKA_MAX_RETRIES=2
ATTACHMENT_STORAGE_TYPE=LOCAL
ALERT_ATTACHMENT_MAX_FILE_SIZE=10MB
ALERT_ATTACHMENT_MAX_TOTAL_SIZE=25MB
ATTACHMENT_LOCAL_DIRECTORY=./data/attachments
ALERT_WEBSOCKET_ENABLED=true
ALERT_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173

# =========================
# SHARED SDK
# =========================
APP_TIMEZONE=UTC
SDK_SECURITY_ENABLED=true
SDK_METHOD_SECURITY_ENABLED=true
SDK_CORS_ENABLED=false
OAUTH2_ISSUER_URI=http://localhost:9005
JWT_PRINCIPAL_ATTRIBUTE=username

# =========================
# MANAGEMENT / ACTUATOR
# =========================
TRACING_SAMPLING_PROBABILITY=0.1

# =========================
# LOGGING
# =========================
LOG_LEVEL_ROOT=DEBUG
LOG_LEVEL_APPLICATION=DEBUG
LOG_LEVEL_KAFKA=DEBUG
LOG_LEVEL_SECURITY=DEBUG
LOG_LEVEL_HIBERNATE_SQL=WARN
LOG_LEVEL_HIBERNATE_BIND=WARN
