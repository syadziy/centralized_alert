{
  "service": "centralized-alert-service",
  "baseUrl": "http://localhost:9003",
  "restApis": [
    {
      "method": "POST",
      "path": "/api/v1/alert",
      "example": "api-create-alert.json"
    },
    {
      "method": "POST",
      "path": "/api/v1/alert/{alertId}/dispatch",
      "example": "api-dispatch-alert.json"
    },
    {
      "method": "GET|POST|PUT|DELETE",
      "path": "/api/v1/alert/recipients",
      "example": "api-recipient-configuration.json"
    }
  ],
  "kafkaEvents": [
    {
      "topicProperty": "alert.kafka.create-topic",
      "defaultTopic": "centralized-alert.create",
      "example": "create-alert.json"
    },
    {
      "topicProperty": "alert.kafka.topic",
      "defaultTopic": "centralized-alert.requested",
      "example": "dispatch-alert.json"
    }
  ],
  "webSocket": {
    "endpoint": "/ws/alerts",
    "destination": "/topic/alerts",
    "example": "websocket-alert-notification.json"
  }
}
